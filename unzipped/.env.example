# Copy this file to .env locally, or add these as Replit Secrets.
# Do not commit real keys/passwords.

# Required for database-backed calibration/history features
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Required for live football fixtures/data
API_FOOTBALL_KEY=your_api_football_key

# Optional: bookmaker odds. If missing, odds sections may show unavailable.
ODDS_API_KEY=your_odds_api_key

# Optional runtime settings
PORT=3000
BASE_PATH=/
FOOTBALL_SEASON=2025
LOG_LEVEL=info
PRETTY_LOGS=false

# Optional mobile/API settings
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DOMAIN=

# Prediction platform options
PREDICTION_MODEL_VERSION=calibrated-statistical-v3
LIVE_STREAM_REFRESH_MS=15000
VALUE_BET_MIN_EDGE_PCT=5
DEFAULT_BET_STAKE=1

# Circumstance learning / richer API-Football pulls
CIRCUMSTANCE_CACHE_MS=900000
MIN_FACTOR_SAMPLE=40

# Background AI learner controls
BACKGROUND_LEARNER_ENABLED=true
BACKGROUND_LIVE_STATS_MS=60000
BACKGROUND_SETTLE_MS=600000
BACKGROUND_TRAIN_MS=21600000
BACKGROUND_BIWEEKLY_UPDATE_MS=1209600000
BACKGROUND_MAX_LIVE_MATCHES=12

# Railway recommended production settings
NODE_ENV=production
BACKGROUND_LEARNER_ENABLED=true
BACKGROUND_LIVE_STATS_MS=60000
BACKGROUND_SETTLE_MS=600000
BACKGROUND_TRAIN_MS=21600000
BACKGROUND_BIWEEKLY_UPDATE_MS=1209600000
BACKGROUND_MAX_LIVE_MATCHES=12
MIN_AUTO_CALIBRATION_SAMPLE=250
